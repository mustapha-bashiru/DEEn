# SebilLink environment variables
#
# Copy this file to `.env.local` and fill in real values. Every `.env*` file
# except this one is git-ignored — never commit a filled-in copy.
#
# ── Scope legend ──────────────────────────────────────────────────────────────
#   server-only  A secret. Must never reach the browser.
#   browser      Safe to ship in the client bundle (public, restricted keys).
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────

# scope: server-only
#
# ⚠️ CURRENTLY LEAKED TO THE BROWSER.
#
# `vite.config.ts` inlines this value into the client bundle so the app can call
# Gemini directly. Anyone who loads the app can read it. This is a tracked defect,
# removed in step 4 of the implementation plan when Gemini moves behind /api.
#
# Until then: use a development-only key with a low quota cap, and do not deploy
# publicly with a key you care about.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ── Optional ─────────────────────────────────────────────────────────────────

# scope: build-time only
#
# Set to `true` to enable the service worker during `npm run dev`. Off by default
# because a live service worker interferes with hot module replacement. Useful
# when testing offline behaviour.
# SW_DEV=false


# ── Supabase ─────────────────────────────────────────────────────────────────
#
# `npm run db:start` prints all three values when the local stack comes up; run
# `npx supabase status` to see them again. Paste them into `.env.local`.
#
# The keys are deliberately left blank here rather than pre-filled with the
# well-known local demo values, because which keys a local stack issues depends on
# the CLI version — recent ones mint per-project keys, and newer ones use the
# `sb_publishable_…` / `sb_secret_…` format instead of JWTs. A pre-filled value that
# silently disagrees with your stack fails as an opaque 401.
#
# Nothing in the client reads these yet. `npm run dev` works without them; the
# `/api` endpoints and `vercel dev` do not.

# scope: browser — the project API URL. This default matches the api port in
# supabase/config.toml, so it is correct for every local stack.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# scope: browser — the anon (publishable) key.
#
# Public by design. Its only power is what row-level security grants it, which is
# why every table in supabase/migrations enables RLS and why supabase/tests asserts
# what this key cannot reach. Shipping it in the bundle is correct.
VITE_SUPABASE_ANON_KEY=

# scope: server-only — the service_role (secret) key.
#
# ⚠️ Bypasses row-level security completely. A browser holding this can read and
# write every row in the database.
#
# It has no `VITE_` prefix and must never acquire one. `scripts/verify-bundle.mjs`
# fails the build if this value appears anywhere in `dist/`, and `api/_lib/env.ts`
# reports it as a critical problem if it is found in the anon slot.
SUPABASE_SERVICE_ROLE_KEY=


# ── Not yet used ─────────────────────────────────────────────────────────────
#
# Listed so the browser/server split is settled before the code arrives. Adding
# any of these has no effect today.

# scope: browser  — HTTP-referrer-restricted Maps JS key (plan step 6)
# VITE_GOOGLE_MAPS_BROWSER_KEY=

# scope: server-only — IP-restricted key for Places/Geocoding/Routes (plan step 6)
# GOOGLE_MAPS_SERVER_KEY=

# scope: browser  — Paystack public key (plan step 8)
# VITE_PAYSTACK_PUBLIC_KEY=

# scope: server-only — Paystack secret key (plan step 8)
# PAYSTACK_SECRET_KEY=

# scope: server-only — verifies Paystack webhook signatures (plan step 8)
# PAYSTACK_WEBHOOK_SECRET=
