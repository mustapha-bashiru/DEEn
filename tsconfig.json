{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],

    "jsx": "react-jsx",
    "allowJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "constants.ts",
    "translations.ts",
    "types.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "config/**/*.ts",
    "services/**/*.ts",
    "types/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
  // `api/**` is deliberately absent — it is typechecked by tsconfig.api.json,
  // which removes the DOM lib so server code cannot reference browser globals.
}
